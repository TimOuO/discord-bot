// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// RPG 系統: 使用者模型
model User {
  id            String   @id @default(uuid())
  userId        String   @unique // Discord 使用者 ID
  username      String
  xp            Int      @default(0) // 經驗值
  level         Int      @default(1) // 等級
  gold          Int      @default(0) // 金幣
  health        Int      @default(100) // 生命值
  maxHealth     Int      @default(100) // 最大生命值
  attack        Int      @default(10) // 攻擊力
  defense       Int      @default(5) // 防禦力
  lastBattle    DateTime? // 上次戰鬥時間
  lastDaily     DateTime? // 上次日常簽到時間
  lastFish      DateTime? // 上次釣魚時間
  lastGather    DateTime? // 上次採集時間
  lastDungeon   DateTime? // 上次挑戰地下城時間
  loginStreak   Int      @default(0) // 連續登入天數
  lastStreakDate String?  // 上次連續登入的日期 (YYYY-MM-DD)
  /// 上次結算離線回血的時間。null 代表還沒算過（既有玩家部署後第一次觸碰時設成當下，不追溯發放）
  lastHealthTick DateTime?

  /// 職業（jobs.ts 的 JobKey），null = 還沒轉職
  job            String?
  /// 已經免費轉職過沒；第一次免費，之後每次要付 JOB_CHANGE_COST
  jobChangedOnce Boolean  @default(false)
  /// 血戰鬥神的連戰：這一趟已經連贏幾場（0 = 沒有進行中的連戰）
  battleStreak      Int     @default(0)
  /// 這一趟連戰保證的那隻菁英怪出現過沒
  streakEliteFired  Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // 關聯
  inventory     Inventory[]
  itemInstances ItemInstance[]
  equipped      EquippedItem[]
  dungeonRun    DungeonRun?
}

// 物品模型
model Item {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  type        String // weapon, armor, potion, accessory, fish, material
  rarity      String   @default("common") // common, uncommon, rare, epic, legendary, mythic
  cost        Int
  effectType  String // 這個 effectValue 要加在哪個屬性上：attack, defense, maxHealth, heal, critRate, dodgeRate, goldBonus, xpBonus
  effectValue Int      @default(0) // 效果值 (攻擊、防禦、生命上限加成或回復量；百分比類效果代表 +N%)
  effectType2 String? // 第二種效果類型，目前只有神話級鍛造裝備會用到，一般道具是 null
  effectValue2 Int? // 第二種效果的效果值，搭配 effectType2 一起出現
  purchasable Boolean  @default(true) // 能不能直接用金幣在商店買；魚/材料/鍛造裝備都是 false
  recipe      Json? // 鍛造配方，[{ "itemName": "...", "quantity": n }, ...]；沒有配方的道具是 null
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 關聯
  inventory     Inventory[]
  itemInstances ItemInstance[]
}

// 庫存模型：只放「可堆疊、個體之間沒有差異」的道具——藥水、魚、材料。
// 裝備不走這裡，因為每一件裝備可以有各自的強化等級，見 ItemInstance
model Inventory {
  id        String   @id @default(uuid())
  userId    String
  itemId    String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 關聯
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

// 裝備實體：一列代表玩家擁有的「一件」武器/防具/飾品。
// 同名裝備可以有多列、各自有不同的強化等級（+7 的屠龍劍跟 +0 的屠龍劍是兩件不同的東西），
// 這是 Inventory 那種「同名就合併成一列加數量」的模型表達不出來的
model ItemInstance {
  id           String   @id @default(uuid())
  userId       String
  itemId       String
  enhanceLevel Int      @default(0) // 強化等級 0~10，每級讓這件裝備的效果值 +10%
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 關聯
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  item      Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  equipped  EquippedItem?

  @@index([userId])
}

// 已裝備物品模型：指向「哪一件」裝備實體，不是指向道具種類，
// 這樣才分得出玩家把 +7 的那把裝上去、還是 +0 的那把
model EquippedItem {
  id             String   @id @default(uuid())
  userId         String
  itemInstanceId String   @unique
  slot           String   // weapon, armor, accessory1, accessory2, accessory3
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // 關聯
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  instance ItemInstance @relation(fields: [itemInstanceId], references: [id], onDelete: Cascade)

  @@unique([userId, slot])
}

// 一趟還沒結束的地下城下潛。一個玩家最多一趟（userId @unique），
// 未完成的趟可以隨時回來繼續或帶著戰利品離開，不會過期。
//
// 為什麼存資料庫而不是記憶體：這個專案的互動一律無狀態、資料即時查，
// 而且現在每天約 6 次部署重啟——玩家打到第 8 層時遇到部署，未入袋的戰利品會直接蒸發。
model DungeonRun {
  id     String @id @default(uuid())
  userId String @unique

  /// 已經打完的層數；0 代表剛開始、還沒打第一層
  clearedFloors Int @default(0)
  /// 這趟目前的血量。層與層之間不回血，血量就是下潛的燃料
  health        Int
  /// 進場當下的有效生命上限，存起來免得中途換裝把基準改掉
  maxHealth     Int
  /// 進場前的血量，離場時回復成這個值（地下城是獨立的一趟，消耗只在趟內生效）
  healthBefore  Int

  /// 未入袋的戰利品，戰敗就全部沒收
  goldPending Int  @default(0)
  /// 經驗不沒收，但一樣累積到離場或戰敗時才結算
  xpPending   Int  @default(0)
  /// 未入袋的材料，[{ "itemId": "...", "name": "...", "quantity": n }]
  lootPending Json

  /// 已經擲好的下一層，玩家看到的存活率跟他真正要打的那層是同一個
  nextFloor Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
