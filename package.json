{
  "name": "discord-bot",
  "version": "1.0.0",
  "description": "Discord bot using TypeScript and Discord.js v14",
  "main": "dist/index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "start:prod": "node dist/index.js",
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "prisma generate && tsc",
    "postbuild": "node -e \"require('fs').cpSync('src/generated/prisma','dist/generated/prisma',{recursive:true})\"",
    "deploy": "tsx src/deploy-commands.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "discord",
    "bot",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "discord.js": "^14.14.1",
    "dotenv": "^17.4.2",
    "prisma": "^7.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "nodemon": "^3.0.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
