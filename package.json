{
  "name": "discord-bot",
  "version": "1.0.0",
  "description": "Discord bot using TypeScript and Discord.js v14",
  "main": "dist/index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "start:prod": "node dist/index.js",
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "prisma generate && tsc",
    "postbuild": "node -e \"require('fs').cpSync('src/generated/prisma','dist/generated/prisma',{recursive:true})\"",
    "deploy": "tsx src/deploy-commands.ts",
    "prepare": "npm run build",
    "db:migrate": "prisma migrate deploy",
    "db:seed:fish": "tsx src/scripts/seedFishItems.ts",
    "db:seed:highTier": "tsx src/scripts/seedHighTierItems.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:typecheck": "tsc -p tsconfig.test.json"
  },
  "keywords": [
    "discord",
    "bot",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-sqlite3": "^12.11.1",
    "discord.js": "^14.14.1",
    "dotenv": "^17.4.2",
    "prisma": "^7.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.1",
    "nodemon": "^3.0.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
